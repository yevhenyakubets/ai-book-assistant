# Copy this file to .env and fill it in. Never commit .env.
OPENAI_API_KEY=your-openai-api-key

# Optional: use a different model (default: gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini

# Optional: where the search history is stored (default: data/history.db)
# DATABASE_PATH=data/history.db

# Optional: when set, /search and /history require "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_ACCESS_TOKEN=

# Optional: contact email included in requests to Open Library
# OPEN_LIBRARY_CONTACT_EMAIL=
